# Заполни и положи на VPS как /tmp/realtor.env. Секреты — только здесь и в
# GitHub Secrets; в репо, most/ и логи не попадают. После install.sh копия
# переносится в /etc/realtor/env (600), /tmp-файл затирается.
BOT_TOKEN=<ЗАПОЛНИТЬ: токен realtor-бота>
BOT_TOKEN_OWNERS=<ЗАПОЛНИТЬ: токен owners-бота>
REALTOR_CHAT_ID=<ЗАПОЛНИТЬ: chat_id риэлтора>
GITHUB_REPO_TOKEN=<ЗАПОЛНИТЬ: GitHub-токен с доступом к репо (clone/push базы)>
